# airaccount-admin —— 社区节点更新 Web 管理台(非 root;仅本机/Tailscale)。
# 部署见同目录 README.md。安全边界:本服务**不碰 root**,一切改盘动作经
# sudoers 白名单里唯一允许的 airaccount-admin-helper 完成。
[Unit]
Description=AirAccount node update web admin (loopback/Tailscale only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airaccount-admin
Group=airaccount-admin
# 绑定与凭据:默认只监听 127.0.0.1:8788。要走 Tailscale 才设 ADMIN_BIND_TAILSCALE=1 +
# ADMIN_BIND_HOST=<你的 100.x 地址>。TELEGRAM_BOT_TOKEN/CHAT_ID 用于二次确认码 OOB 推送。
EnvironmentFile=/etc/airaccount/admin.env
ExecStart=/opt/airaccount/admin/airaccount-admin
Restart=on-failure
RestartSec=3

# ── 加固(纵深防御;管理台是最高价值攻击面)──────────────────────────
NoNewPrivileges=false
# ↑ helper 需经 sudo 提权,故不能 NoNewPrivileges;其余尽量收紧:
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# 只读根;trust root 目录保持只读(env/pubkey 不可被本服务改)。
ReadOnlyPaths=/etc/airaccount
# ⚠️ sudo **不**建新 mount namespace,故 helper→updater(root)子进程继承本单元的
#    ProtectSystem=strict 视图。apply/rollback 要写 /opt/airaccount(releases/current 软链)
#    与 /var/lib/airaccount/updater(state.json),必须显式放行,否则生产上写盘 EROFS 失败。
ReadWritePaths=/opt/airaccount /var/lib/airaccount
# 网络:只允许本机 + Tailscale/私网(不放行公网出站也可,但 Telegram 需出站 443)。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
