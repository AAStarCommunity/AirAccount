# /etc/airaccount/updater.env —— 社区节点自动更新配置(社区可改 = 主权)
# 见 kms/docs/auto-update-design.md

# 总开关。MVP 默认 notify-only(只通知不自动应用)。
# 首启向导显式 opt-in 才建议改成 on。
AUTO_UPDATE=notify-only          # on | notify-only(=off 的自动应用,仍通知)

# 通道。对应 channels/<CHANNEL>.json
CHANNEL=stable                   # stable | beta

# 应用策略(AUTO_UPDATE=on 时生效)
UPDATE_POLICY=security           # security(仅签名标注的安全 patch 自动) | minor | all | off

# TA 变更(RSA-4096 签名,牵动 secure storage)默认只通知,不自动应用。
TA_AUTO_UPDATE=off               # off | on

# 锁定版本(白名单):填了则只认这个版本 —— 别的候选一律不动。
# 注意:仍受 AUTO_UPDATE 总开关约束 —— AUTO_UPDATE=on 时匹配到该版本才自动应用;
# notify-only 时即使出现该版本也只通知不自动应用(总开关优先于 PIN)。
PIN_VERSION=

# 保留最近几个版本目录(供回滚)。
KEEP_RELEASES=3

# 当前板子的真实 TA 版本(用于 CA 的 requires_ta_version 兼容门,x.y.z)。
# 不设 → 兼容门 fail-closed:任何声明了 requires_ta_version 的 CA 更新都不会自动应用/
# 会拒绝(安全优先,避免 CA/TA 漂移)。刷 TA 后由 installer/OOB 更新此值,或写到
# $AU_ROOT/current/TA_VERSION 文件(env 优先)。
# AU_TA_VERSION=0.29.0

# ── 通知(Telegram)──────────────────────────────────────────────────
# updater 发现新版(notify-only 或有更高不自动应用的候选)时推 Telegram。
# 复用 AAStarMonitorBot(token 见运维私有 ~/Dev/.env 的 AAstarMonitorBot_TOKEN)。
# 打开:把 AU_NOTIFY_CMD 指到 notify-telegram.sh,并填 TOKEN/CHAT_ID。
# AU_NOTIFY_CMD=/opt/airaccount/updater/notify-telegram.sh
# TELEGRAM_BOT_TOKEN=<AAstarMonitorBot_TOKEN>
# TELEGRAM_CHAT_ID=<你的 chat id>
#
# 通知内容(富通知)含:当前→新版本、安全级别(none/low/medium/high/critical)、
# 变动摘要(manifest.notes)、是否含 TA。去重 key=version+hash+severity+ta_changed+metadata_version。
# 收到通知后应用:ssh 进板跑  aastar-node-updater apply <ver>
# (含 TA 变更的更新只通知、apply 一律拒绝在线应用;TA 更新走 OOB / 专门流程 —— 决策 D。)
